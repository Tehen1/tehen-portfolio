{
  "name": "tehen-portfolio",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tehen/database db:generate",
    "db:push": "pnpm --filter @tehen/database db:push",
    "db:migrate": "pnpm --filter @tehen/database db:migrate",
    "db:seed": "pnpm --filter @tehen/database db:seed"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "5.6",
    "eslint": "9",
    "prettier": "3",
    "vitest": "5",
    "playwright": "1"
  },
  "packageManager": "pnpm@9"
}